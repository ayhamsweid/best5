@font-face {
 font-family: 'arabicfont';
 src: url('https://think-schools.org/wp-content/themes/educavo/assets/fonts/Almarai-Regular.ttf');
 font-weight: normal; 
}
#rs-header.header-style3 .menu-sticky .menu-area {
 background: transparent;
}
.rs-newsletter {
 margin-bottom: 0;
 position: absolute;
 z-index: 10;
 transform: translateY(-50%);
 width: 100%;
}
.rs-newsletter { 
 display: none;
}
.p-user ,.ps-informations, .project-desc .title-bg-gray  {
 display:none;
}
.single-teams .short-desc{
 margin-bottom: 10px;
}
.main-contain #content, body.rs-pages-btm-gap .main-contain #content {
 padding-top: 40px!important;
 padding-bottom: 0px!important;
}
blockquote::after{
 background: #c20f0b;
}  body #rs-header .toolbar-area .toolbar-contact ul.rs-contact-info li a:hover, body #rs-header .toolbar-area .toolbar-contact ul li a:hover, body #rs-header .toolbar-area .toolbar-contact ul li:hover i:before, body #rs-header .toolbar-area .toolbar-contact ul li i:hover, body .tops-btn .btn_login a:hover, body #rs-header .toolbar-area .toolbar-sl-share ul li a i:hover {
 color: #c20f0b !important;
}
.fa-tumblr, .fa-twitter {
 font-family: "Font Awesome 6 Brands";!important;
}
.fa-pinterest-p:before{
 content:"\f2ab"!important;
}
.fa-tumblr:before{
 content: "\e07b"!important;
}
.rs-contact-phone a{
 unicode-bidi: embed;
 direction:ltr!important;
 padding-right:8px
}
.fa-twitter:before {
    content: "\e61b"!important; 
}  p {
 text-align:justify!important;
 }
@media (max-width: 768px) {
 p {
 text-align: justify;
 text-justify: inter-word;
 word-spacing: -1px; 
 }
}
.rtl p, .rtl h1, .rtl h2, .rtl h3, .rtl h4, .rtl h5, .rtl h6, .rtl a, .rtl span, .rtl blockquote, .rtl div , .rtl btn_text  {
 font-family:'arabicfont', Sans-serif!important;
}
.rs-footer.rs-footer-top-gap .footer-top {
 padding-top: 80px;
}  .menu-area .navbar ul > li > a:hover span {
 transform: none;
}
.team-grid-style5 .team-inner-wrap, .team-slider-style5 .team-inner-wrap {
 padding-bottom: 129px;
}
.team-slider-style5 .team-inner-wrap .image-wrap img{

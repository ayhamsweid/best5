 background-size:auto !important;
 } 
 .rs-newsletter .newsletter-wrap{
 background:#172E58;
 } 
 .tops-btn .quote-buttons{
 background:#C20F0B;
 } 
 .tops-btn .quote-buttons{
 color:#FFFFFF;
 } 
 .toolbar-area .toolbar-contact i, 
 .toolbar-area .opening i, 
 .toolbar-area .opening i:before, 

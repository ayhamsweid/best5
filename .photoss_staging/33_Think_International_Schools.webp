 background:#FFFFFF;
 } 
 h1{
 color:#00203a;				font-size:45px; 
 line-height:56px; 
 }
 h2{
 color:#00203a; 
 font-size:36px; 
 line-height:40px			}
 h3{
 color:#00203a ; 
 font-size:28px; 
 line-height:32px;
 }
 h4{
 color:#00203a;
 font-size:20px; 
 line-height:28px; 
 }
 h5{
 color:#00203a;
 font-size:20px; 
 line-height:28px;
 }
 h6{
 color:#00203a ;
 font-size:18px; 
 line-height:20px;
 }
 .menu-area .navbar ul li > a,
 .sidenav .widget_nav_menu ul li a{
 font-size:15px;
 }
 #rs-header .toolbar-area .toolbar-contact ul.rs-contact-info li,
